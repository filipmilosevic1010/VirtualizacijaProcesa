<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="BatchSize" value="20"/>
	</appSettings>
	<system.serviceModel>
		<client>
			<endpoint name="GalaxyPPGService"
					  address="net.tcp://localhost:8733/GalaxyPPG/Service"
					  binding="netTcpBinding"
					  contract="GalaxyPPG.Common.IGalaxyPPGService" />
		</client>
		<bindings>
			<netTcpBinding>
				<binding maxReceivedMessageSize="10485760">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>