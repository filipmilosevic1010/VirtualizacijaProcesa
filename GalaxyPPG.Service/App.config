<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="EcgSpikeThresholdMicroV" value="1000"/>
		<add key="HrMinBpm" value="30"/>
		<add key="HrMaxBpm" value="220"/>
		<add key="AccMotionThreshold" value="2.0"/>
	</appSettings>
	<system.serviceModel>
		<services>
			<service name="GalaxyPPG.Service.GalaxyPPGService"
					 behaviorConfiguration="ServiceBehavior">
				<endpoint address="Service"
						  binding="netTcpBinding"
						  contract="GalaxyPPG.Common.IGalaxyPPGService" />
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8733/GalaxyPPG/" />
					</baseAddresses>
				</host>
			</service>
		</services>
		<bindings>
			<netTcpBinding>
				<binding maxReceivedMessageSize="10485760">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>
		<behaviors>
			<serviceBehaviors>
				<behavior name="ServiceBehavior">
					<serviceMetadata />
					<serviceDebug includeExceptionDetailInFaults="true" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>